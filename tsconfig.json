{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // noUnusedLocals/Parameters live in the audit gate, not this gate: the
    // @glaphic/ui source alias pulls the library's sources into this
    // program, and its three dead symbols (film-button's unused LitElement
    // import, tape's `tail`, wipe's `ev`) are out of this repo's reach.
    // Site code is clean under both flags — re-run them as an audit with:
    //   npx tsc --noEmit --noUnusedLocals --noUnusedParameters
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false,
    "noImplicitAny": true,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@glaphic/ui": ["../glaphicUI/src/index.ts"],
      "@glaphic/ui/*": ["../glaphicUI/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
